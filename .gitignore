# Monorepo dependencies
node_modules/
apps/*/node_modules/
packages/*/node_modules/
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Turborepo
.turbo/
apps/*/.turbo/
packages/*/.turbo/

# Build output
.next/
apps/*/.next/
packages/*/.next/
out/
apps/*/out/
dist/
build/
coverage/

# TypeScript
*.tsbuildinfo
next-env.d.ts
apps/*/next-env.d.ts
apps/*/tsconfig.tsbuildinfo
packages/*/tsconfig.tsbuildinfo

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Supabase local state
supabase/.temp/
supabase/.branches/

# Private work state
/.plan/
.codex-private/
.playwright-cli/
output/
my-agent/
*.log
__pycache__/
*.pyc

# The Eve skill only needs its entry point; framework code comes from the package.
.agents/skills/eve/*
!.agents/skills/eve/SKILL.md
!.agents/skills/eve/LICENSE
!.agents/skills/eve/NOTICE

# Vercel
.vercel/
apps/*/.vercel/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Misc
tmp/
.DS_Store
*.pem
