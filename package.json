{
  "name": "kocteau",
  "version": "0.3.15",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francozeta/kocteau.git"
  },
  "bugs": {
    "url": "https://github.com/francozeta/kocteau/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docs:check": "node apps/web/scripts/build-docs.mjs",
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "supabase:start": "supabase start -x logflare,vector",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "supabase db lint --local --fail-on error",
    "supabase:version": "supabase --version",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:list": "supabase migration list",
    "supabase:migration:list:linked": "supabase migration list --linked",
    "supabase:db:push:dry": "supabase db push --linked --dry-run",
    "supabase:db:push": "supabase db push --linked",
    "supabase:db:lint:linked": "supabase db lint --linked --fail-on error",
    "supabase:db:advisors:linked": "supabase db advisors --linked --fail-on error",
    "supabase:types": "node supabase/scripts/generate-types.mjs",
    "supabase:types:linked": "node supabase/scripts/generate-types.mjs --linked",
    "curate:starter:draft": "node supabase/scripts/create-starter-curation-draft.mjs",
    "curate:starter:sql": "node supabase/scripts/create-starter-curation-apply-sql.mjs",
    "curate:entity:draft": "node supabase/scripts/create-entity-curation-draft.mjs",
    "curate:entity:sql": "node supabase/scripts/create-entity-curation-apply-sql.mjs",
    "import:apple-playlist": "tsx apps/web/scripts/export-apple-music-playlist.ts",
    "sync:apple-starter-source": "tsx apps/web/scripts/sync-apple-starter-source.ts",
    "perf:load:smoke": "k6 run -e K6_PROFILE=smoke apps/web/tests/load/kocteau.js",
    "perf:load:baseline": "k6 run -e K6_PROFILE=baseline apps/web/tests/load/kocteau.js",
    "build": "turbo run build",
    "test": "pnpm --filter web test",
    "lint": "turbo run lint",
    "check": "pnpm docs:check && pnpm test && pnpm lint && pnpm --filter web build",
    "perf:search:smoke": "k6 run -e K6_PROFILE=smoke -e K6_SEARCH_ONLY=1 -e K6_SEARCH_SOURCE=local -e K6_SEARCH_REQUIRE_MATCHES=1 apps/web/tests/load/kocteau.js",
    "perf:search:baseline": "k6 run -e K6_PROFILE=baseline -e K6_SEARCH_ONLY=1 -e K6_SEARCH_SOURCE=local -e K6_SEARCH_REQUIRE_MATCHES=1 apps/web/tests/load/kocteau.js",
    "perf:reads:fixture": "node apps/web/tests/load/fixtures/public-data.mjs",
    "perf:reads:verify": "node apps/web/tests/load/verify-public-reads.mjs",
    "perf:feed:seed": "node apps/web/tests/load/fixtures/seed-local-feed.mjs",
    "perf:feed:verify": "node apps/web/tests/load/verify-feed-reads.mjs",
    "perf:feed:browser": "node apps/web/tests/load/verify-authenticated-feed.mjs",
    "perf:starter:verify": "node supabase/scripts/verify-starter-query.mjs",
    "perf:journey:verify": "node apps/web/tests/load/verify-journey-tracing.mjs",
    "perf:journey:baseline": "node apps/web/tests/load/measure-public-journeys.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.109.1",
    "tsx": "^4.22.4",
    "turbo": "2.9.16"
  }
}
