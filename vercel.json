{
  "crons": [
    {
      "path": "/api/cron/enrich-catalog",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": [
    "gru1"
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch, Accept"
        }
      ]
    }
  ]
}
